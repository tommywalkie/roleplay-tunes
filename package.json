    "@tabler/icons": "^3.34.0",
    "@types/node": "^20.11.0",
    "concurrently": "^10.0.7",
    "emojibase-data": "^18.0.0",
    "eslint": "^10.12.0",
    "healthicons": "^3.1.0",
    "lucide-static": "^0.511.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
