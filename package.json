{
  "name": "roleplay-tunes",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:server": "pnpm --filter @dnd/server dev",
    "dev:web": "pnpm --filter @dnd/web-v2 dev",
