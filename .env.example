# Settings of the server (apps/server). Copy to apps/server/.env for local use, or set
# them in the deployment stack. Validated at start: the server refuses to start on an
# invalid value.

# "production" on the server. Makes AUTH_SECRET mandatory.
NODE_ENV=production

# Address and port the server listens on inside its container.
HOST=0.0.0.0
PORT=3000

# Folder holding the database, audio files and images. Mount a volume here and back it up.
DATA_DIR=/data

# Public address of the app, exactly as users type it. No trailing slash.
PUBLIC_URL=https://ambiance.example.com

# Secret used to sign sessions. Required in production, 32 characters minimum.
# Generate one with: openssl rand -base64 48
AUTH_SECRET=

# The account with this email is an admin. Default when unset: admin@roleplay-tunes.local
# (an unrouteable placeholder — no real mailbox exists there).
#
# REGISTRATION RACE: with public sign-up and no email verification,
# WHOEVER REGISTERS THE ADMIN EMAIL FIRST BECOMES ADMIN. Register admin@roleplay-tunes.local
# immediately after the first deployment, BEFORE announcing the URL.
#
# The default is a shared secret-by-obscurity at best: production deployments should set
# their own ADMIN_EMAIL — an address nobody can guess (and that receives no real mail,
# since the server sends no email).
# ADMIN_EMAIL=admin@roleplay-tunes.local

# Folder of the built web app (apps/web-v2/dist). Leave empty to serve the API only.
WEB_DIST=/app/web

# "true" behind a reverse proxy such as Traefik, so client addresses are read from the
# forwarded headers (needed for rate limits).
TRUST_PROXY=true

# Optional. Extra browser origins allowed to call the API, comma separated.
# TRUSTED_ORIGINS=# Optional. fatal, error, warn, info, debug, trace or silent. Default: info.
# LOG_LEVEL=info
# Optional. "false" turns rate limits off (local development and automated tests only).
# RATE_LIMIT=true
