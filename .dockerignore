# Keep the build context small and never ship local data or secrets.
**/node_modules
**/dist
**/dev-dist
**/coverage
**/.vitest
**/*.tsbuildinfo

.git
.github
.agents
.team
.env
.env.*
!.env.example

tmp
test-results
playwright-report
docs
e2e

# Local SQLite database and uploads
apps/server/data

# Generated by scripts/build-icon-libraries.mjs during the image build
apps/web-v2/public/icons
